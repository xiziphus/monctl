<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before it does. -->
    <style name="Theme.Monctl" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Monctl.Translucent" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
