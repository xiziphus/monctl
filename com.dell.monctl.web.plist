<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dell.monctl.web</string>
  <!-- /usr/bin/python3 explicitly, NOT 'env python3'.
       env resolves to Homebrew python, which is not in this Mac's firewall
       allow-list, so inbound LAN connections to it are dropped with no error
       anywhere. -u keeps /tmp/monctl-web.log unbuffered.
       --lan is safe because server.py always requires its token from
       ~/.config/monctl/token for anything but direct loopback; the token is
       deliberately not on this command line. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>__SERVER__</string>
    <string>--no-browser</string>
    <string>--port</string>
    <string>8770</string>
    <string>--lan</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart on a real crash only. server.py exits 0 when the port is already
       taken, so a duplicate launch cannot turn into a respawn loop. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/monctl-web.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/monctl-web.log</string>
  <!-- Standard, not Background: children inherit the darwin-background
       throttle, and `say`/`afplay` started from here (the watcher's test
       announcement, the toggle cues) came out garbled under it. The server is
       idle almost all the time, so this costs nothing noticeable. -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
